<resources>
    <!--
        Base application theme: Material 3 with dynamic colour, dressed in the
        Material 3 Expressive shape, colour and type language.
    -->
    <style name="BugleBaseTheme" parent="Theme.Material3.DynamicColors.DayNight">
        <item name="android:navigationBarColor">@color/navigation_bar_bg</item>
        <item name="android:windowLightNavigationBar">@bool/light_navigation_bar</item>
        <item name="android:statusBarColor">@color/action_bar_background_color</item>
        <item name="android:windowLightStatusBar">@bool/light_status_bar</item>
        <item name="android:elegantTextHeight">true</item>

        <!-- Colour roles, shared with the drawables through @color/m3_* -->
        <item name="colorPrimary">@color/m3_primary</item>
        <item name="colorOnPrimary">@color/m3_on_primary</item>
        <item name="colorPrimaryContainer">@color/m3_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/m3_on_primary_container</item>
        <item name="colorSecondaryContainer">@color/m3_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/m3_on_secondary_container</item>
        <item name="colorTertiaryContainer">@color/m3_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/m3_on_tertiary_container</item>
        <item name="colorSurface">@color/m3_surface</item>
        <item name="colorOnSurface">@color/m3_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/m3_on_surface_variant</item>
        <item name="colorOutline">@color/m3_outline</item>
        <item name="colorError">@color/m3_error</item>
        <item name="android:colorBackground">@color/window_background</item>
        <item name="android:windowBackground">@color/window_background</item>

        <!-- Expressive shapes: generously rounded, with a wider small-to-large range -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Bugle.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Bugle.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Bugle.Large</item>
    </style>

    <!-- Application theme. -->
    <style name="BugleTheme" parent="BugleBaseTheme">
        <!-- All customizations that are NOT specific to a particular API-level can go here. -->
        <item name="android:dropDownListViewStyle">@style/DropDownListViewStyle</item>
        <item name="android:textColorHighlight">@color/text_highlight_color</item>
        <item name="actionBarStyle">@style/BugleActionBar</item>
        <item name="actionBarSize">@dimen/action_bar_height</item>
        <item name="popupMenuStyle">@style/BuglePopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/BuglePopupMenu.Overflow</item>
        <item name="actionModeBackground">@color/contextual_action_bar_background_color</item>
        <item name="alertDialogTheme">@style/AlertDialogTheme</item>
        <item name="preferenceTheme">@style/AppPreferenceThemeOverlay</item>
    </style>

    <style name="LaunchTheme" parent="BugleTheme" />

    <style name="BugleTheme.ConversationActivity"
        parent="@style/BugleTheme.ConversationActivityBase">
        <item name="android:colorEdgeEffect">@color/conversation_edge_effect</item>
    </style>

    <style name="BugleTheme.ConversationActivityBase" parent="BugleTheme">
        <item name="android:colorBackground">@color/conversation_background</item>
        <item name="android:windowBackground">@color/conversation_background</item>
        <item name="android:statusBarColor">@color/conversation_action_bar_background_color</item>
        <item name="android:navigationBarColor">@color/conversation_background</item>
        <item name="windowActionBarOverlay">true</item>
        <item name="android:fastScrollPreviewBackgroundLeft">@drawable/contacts_fastscroll_label_left</item>
        <item name="android:fastScrollPreviewBackgroundRight">@drawable/contacts_fastscroll_label_right</item>
        <item name="android:fastScrollTextColor">@color/m3_on_primary</item>
    </style>

    <style name="BugleTheme.DialogActivity" parent="@style/Theme.Material3.DayNight.Dialog">
        <item name="android:windowNoTitle">false</item>
        <item name="colorPrimary">@color/m3_primary</item>
        <item name="colorSurface">@color/m3_surface_container_high</item>
        <item name="colorOnSurface">@color/m3_on_surface</item>
        <item name="android:colorBackground">@color/m3_surface_container_high</item>
        <item name="android:dialogCornerRadius">28dp</item>
        <item name="android:elegantTextHeight">true</item>
    </style>

    <style name="BugleTheme.ConversationListActivity" parent="BugleTheme" />

    <style name="BugleTheme.ArchivedConversationListActivity" parent="BugleTheme.ConversationListActivity" />

    <style name="BugleTheme.SettingsActivity" parent="BugleTheme">
        <item name="android:textSize">@dimen/settings_list_text_size</item>
    </style>

    <style name="BugleTheme.NoActionBar" parent="BugleTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Shown while the app is missing its permissions; has no action bar -->
    <style name="BugleTheme.PermissionCheckActivity" parent="BugleTheme">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Invisible" parent="BugleBaseTheme">
        <item name="android:windowBackground">@null</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowNoDisplay">true</item>
    </style>

    <style name="ShapeAppearance.Bugle.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.Bugle.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ShapeAppearance.Bugle.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">28dp</item>
    </style>

    <style name="BuglePopupMenu" parent="@style/Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/popup_menu_background</item>
    </style>

    <style name="BuglePopupMenu.Overflow" parent="@style/Widget.Material3.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/popup_menu_background</item>
    </style>

    <style name="BugleActionBar" parent="@style/Widget.Material3.ActionBar.Solid">
        <item name="height">@dimen/action_bar_height</item>
        <item name="displayOptions">showTitle</item>
        <item name="background">@color/action_bar_background_color</item>
        <item name="elevation">0dp</item>
